# ============================================================================
# QPULL — configuration (copy to .env and fill in)
#
# ⚠  ADDRESSES: from the official Quotrons builders manifest. The values below were
#    cross-checked ON-CHAIN (2026-09-07) via router.poolKey() on Robinhood Chain (4663):
#    currency0=WETH, currency1=QUOTRON, fee=0x800000 (dynamic), hooks=WETH fee hook.
#    (This is the RH-Chain deployment, NOT the Ink 57073 / USDG-quoted one.) Re-verify before mainnet.
#    On chainid 4663 Deploy.s.sol and GoLiveMainnet.s.sol REFUSE any other QUOTRON / QUOTRON_ROUTER / WETH /
#    POOL_MANAGER (pinned in script/LaunchGuards.sol).
#
# SIGNING: never put a private key in this file. Sign with a keystore or hardware wallet
#    (`forge script ... --account <keystore name>`). The keeper's hot keys live in keeper/.env only.
#    MAINNET NFT DEPLOYER: sign DeployNFT (and every later deployer step) as `--account <nft deployer>`, the key
#    must have no code (a plain key), nonce 0 on 4663, and must not be the testnet deployer. Do not reuse the testnet
#    `deployer` keystore alias for it: any transaction from the NFT deployer before DeployNFT moves the published
#    NFT address.
#
# UNITS: every amount says its unit. D18{QPULL} / D18{QUOTRON} = token base units (1e18 = one token);
#    wei = WETH/ETH wei (1e18 = 1 ETH); seconds = unix seconds.
# ============================================================================

# --- RPC ---
RH_RPC_URL=                    # Robinhood Chain RPC (required by every fork test)

# --- Quotron integration (from manifest; pinned on 4663) ---
QUOTRON=0x5a86828Efd322bfb16d93cFeD16EE9BC14940D7F   # V2 $QUOTRON (ERC-404 core) — verified on-chain
WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73       # Canonical WETH — verified (router.poolKey currency0)
POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951 # Uniswap v4 PoolManager (RH mainnet and testnet)
QUOTRON_ROUTER=0x42024fCFdB4F3089Dd619A0cEF0Cd24E7b841C18 # Canonical ETH router (buyExactEth); Deploy builds the WETH->QUOTRON adapter against it
# The Quotron pool's OWN key is fee 8388608 (0x800000, dynamic) / tickSpacing 60. Informational only: nothing reads it.
# VIEW_QUOTER=0xb8960fdC8A0Be155d196C2795b75747763562df2 # Quotron View quoter — used by the KEEPER (leg-2 minOut); set in keeper/.env

# --- Phase 0: oracle + art (before DeployNFT) ---
# The oracle (script/DeployOracle.s.sol) and the art (script/DeployPassArt.s.sol), run from a wallet OTHER than the NFT
# deployer, with both addresses below set:
#   forge script script/DeployOracle.s.sol --rpc-url rh --account <oracle key> --broadcast --slow
#   forge script script/DeployPassArt.s.sol --rpc-url rh --account <art key> --broadcast --slow
# EXPECTED_NFT_DEPLOYER=       # the NFT deployer's ADDRESS (not a key). REQUIRED whenever EXPECTED_NFT_ADDRESS is set: DeployOracle
                               #   and DeployPassArt refuse EXPECTED_NFT_ADDRESS without it. Both refuse to run from this address,
                               #   and from any key that would create EXPECTED_NFT_ADDRESS at a nonce the run uses (that key is the
                               #   NFT deployer, whatever this value says). With neither value set they check nothing.
DRAND_ORACLE=                  # REQUIRED by DeployNFT and Deploy: the BlsDrandOracle(1692803367, 3) DeployOracle prints. Both scripts
                               #   check it is the quicknet oracle (a mock or a codeless address is refused), and Deploy checks it
                               #   equals NFTCollection.drand().
RENDERER_ADDR=                 # REQUIRED by DeployNFT: the LOCKED PassArtRenderer (script/DeployPassArt.s.sol)

# --- Phase 1: the raise (script/DeployNFT.s.sol) ---
MINT_PRICE_WEI=7500000000000000 # REQUIRED, wei per pass (immutable). 0.0075 ETH.
REVEAL_DELAY=3600              # REQUIRED, seconds (immutable, >= 1 hour). Read by DeployNFT (pass reveal), Deploy (pack reveal)
                               #   and the keeper, under this one name.
LP_TREASURY=                   # REQUIRED: THE DEPLOYER KEY that runs GoLiveMainnet (DeployNFT and GoLiveMainnet both refuse anything
                               #   else). Receives the 80% LP bucket. Never the QpullLiquidityLock (it cannot receive ETH).
SEED_TREASURY=                 # REQUIRED: receives the 10% prize seed, and is used for nothing else. A SEPARATE REGULAR WALLET: DeployNFT
                               #   refuses the deployer key (LP_TREASURY), TEAM_WALLET, an address with code, a precompile/system
                               #   address, or one that cannot take a 1-wei ETH probe. It later runs script/SeedRaffleVault.s.sol
                               #   once, right after go-live and before the opening draw.
# SEED_TREASURY_ALLOW_CONTRACT=true # optional override, default false: set ONLY if SEED_TREASURY is deliberately a contract wallet
                               #   (a Safe). DeployNFT then REQUIRES code there; SeedRaffleVault prints the calldata to submit from it.
DELEGATE_REGISTRY=             # optional: delegate.xyz v2 on RH (0x00000000000000447e69651d841bD8D104Bed493) to enable delegated mints.
                               #   REQUIRED when EXPECTED_NFT_ADDRESS is set, and on 4663 it must then be exactly that registry.
# EXPECTED_NFT_ADDRESS=        # optional, the DELEGATION-ONLY LAUNCH: the NFT address published before DeployNFT runs, i.e.
                               #   CREATE(NFT deployer, its current nonce): nonce 0 for a key that has never sent on 4663
                               #   (`cast compute-address <nft deployer> --nonce 0`). Set EXPECTED_NFT_DEPLOYER with it (DeployOracle
                               #   and DeployPassArt refuse this without it). DeployNFT then refuses to broadcast unless its CREATE lands
                               #   exactly there, refuses a deployer account that has code (EIP-7702), and, if the address already holds
                               #   this deployer's NFTCollection (a partial broadcast), only finishes setRecipients / setDelegateRegistry
                               #   instead of deploying a second NFT. The NFT deployer key must send NOTHING else before DeployNFT
                               #   (not the oracle, not the art). Broadcast DeployNFT with --slow.

# --- Phase 2: protocol deploy (script/Deploy.s.sol) ---
NFT_ADDRESS=                   # REQUIRED: the NFTCollection from DeployNFT (the hook binds it as an immutable)
GENESIS=                       # REQUIRED, unix SECONDS of the PLANNED GO-LIVE (the lock.seed transaction). Every engine/registry clocks
                               #   its days/weeks from it. Deploy refuses a GENESIS in the past, more than 60 days out (a millisecond
                               #   value is refused) or before finalizeLaunch. GoLiveMainnet refuses to run more than 1h before it,
                               #   and more than 12h after it unless ACCEPT_GENESIS_SLIP_SECS declares the slip.
TICKET_PRICE_WETH=             # REQUIRED, wei of ETH-IN per ticket (tickets are priced off the WETH going into a buy). ~$10 of ETH
                               #   at launch, e.g. 3000000000000000 (0.003 ETH). Owner re-pegs within +/-25%/day.
TEAM_WALLET=                   # REQUIRED: receives the 20%-of-tax team + operations slice (WETH) and the NFT's 10% team bucket
KEEPER=                        # REQUIRED: the convert() keeper address (the CONVERT_PK address in keeper/.env). Never the deployer.
                               #   Deploy, GoLiveMainnet and TransferOwnership all pin it: it must be the Treasury's ONLY keeper.
CONVERT_THRESHOLD=1000000000000000000000 # REQUIRED, D18{QPULL}, >= 1e18 (dust-QPULL convert grief). GoLiveMainnet
                               #   also requires it to quote >= 1e12 wei at the seed price and to be <= MAX_CONVERT_PER_CALL.
                               #   1000 QPULL quotes ~2.1e13 wei at the sell-out launch price.
EARLY_BUY_CAP_WEI=250000000000000000 # REQUIRED, wei. Max WETH one wallet may spend per buy during the 1-hour holder gate (hook
                               #   immutable, fixed ETH not USD): RE-CHECK AGAINST THE ETH PRICE BEFORE DEPLOYING.
# On 4663 Deploy refuses TICKET_PRICE_WETH outside [1e14, 1e17] wei and EARLY_BUY_CAP_WEI outside [1e16, 5e18] wei (unit
#   slips). To launch with an out-of-band value on purpose, set the matching override to EXACTLY that value:
# ACCEPT_TICKET_PRICE_WETH=    # optional, wei: must equal TICKET_PRICE_WETH
# ACCEPT_EARLY_BUY_CAP_WEI=    # optional, wei: must equal EARLY_BUY_CAP_WEI
QPULL_POOL_FEE=3000            # optional, the canonical QPULL/WETH pool's static LP fee in hundredths of a bip (default 3000 = 0.30%).
                               #   NOT the Quotron pool's 0x800000 (the hook refuses a dynamic fee).
QPULL_POOL_TICK_SPACING=60     # optional, the canonical QPULL/WETH pool's tick spacing (default 60; must be 1..32767)
# Deploy.s.sol also deploys the site's swap router (src/periphery/QpullSwapRouter.sol; no env of its own) and prints it on its
#   own line as "SWAP ROUTER (site buy/sell): 0x..." for script/wire-web.mjs.
# INITIAL_SUPPLY=1000000000000000000000000000 # optional, D18{QPULL} (default 1e27 = 1B QPULL, 100% seeded into the lock)
WINNERS_PER_DAY=10             # REQUIRED. Winners per daily raffle. At 10: Super Rare ~1 day in 10 (45% of pot solo), Rare ~1 day
                               #   in 3 (25% solo), Commons 1.25% each.
RAFFLE_CAP_BPS=1000            # REQUIRED, bps of the prize vault a single day may pay (1000 = 10%/day; contract max 5000). The
                               #   primary ceiling; RAFFLE_POT_CAP is an absolute backstop behind it.
# --- Dust floors: ALL REQUIRED (>0) ---
RAFFLE_MIN_POT=                # D18{QUOTRON}: below this the daily raffle voids without consuming the day
LEADERBOARD_MIN_POT=           # D18{QUOTRON}: below this the weekly leaderboard voids without consuming the week
HOLDER_MIN_POT=                # D18{QUOTRON}: below this the weekly holder draw voids (<= HOLDER_POT_CAP)
# --- Per-draw caps: ALL REQUIRED (>0), >= the matching MIN_POT ---
RAFFLE_POT_CAP=                # D18{QUOTRON}: bound a single day's raffle payout; excess rolls forward
LEADERBOARD_POT_CAP=           # D18{QUOTRON}: bound a single week's leaderboard payout; excess rolls forward
HOLDER_POT_CAP=                # D18{QUOTRON}: holder-draw per-draw cap
HOLDER_POT_CEILING=            # D18{QUOTRON}: immutable ceiling on the holder-draw cap (>= HOLDER_POT_CAP)

# --- Phase 3: go-live (script/GoLiveMainnet.s.sol) ---
# Run from the deployer key (= the LOCK's opener = Treasury owner = NFTCollection.lpTreasury) AFTER finalizeLaunch().
# Do NOT call withdrawProceeds first: while the LP bucket is still in the NFT the script anchors LP_ETH_WEI to it EXACTLY and
# withdraws it itself. Deploy.s.sol prints an `export NAME=` block with every address below.
# Also required from above: POOL_MANAGER, WETH, QUOTRON, QUOTRON_ROUTER, TEAM_WALLET, KEEPER.
# fee / tickSpacing are NOT env here: they are read from the hook (the only key it admits).
QPULL=                         # QPULLToken — cross-checked against hook.qpull()
TREASURY=                      # Treasury — cross-checked against hook.treasury()
HOOK=                          # QpullTaxHook — its REQUIRED_FLAGS must be 0x1ACC
LOCK=                          # QpullLiquidityLock (Deploy prints it as "LiquidityLock" and as export LOCK=). It IS the hook's
                               #   `initializer`: the only address that may create the canonical pool or add liquidity to it.
PRIZE_VAULT=                   # the four destinations and two adapters Treasury.lockRouting FREEZES: each is compared with the
HOLDER_VAULT=                  #   Treasury before anything is sent, and the QUOTRON binding of every vault and adapter is checked
LEADERBOARD_VAULT=             #   against QUOTRON / QUOTRON_ROUTER, then exercised by a simulated convert() before the lock.
QPULL_WETH_ADAPTER=
WETH_QUOTRON_ADAPTER=
LP_ETH_WEI=                    # REQUIRED, wei of WETH seeded into the pool. MUST EQUAL the mint's LP bucket (NFTCollection.lpReserve,
                               #   80% of what the mint raised: 20850000000000000000 at a 3500-pass sell-out with a 25-pass reserve)
                               #   plus LP_TOPUP_WEI: exact while the bucket is still in the NFT, only bounded after an early
                               #   withdrawProceeds. A 10x or wei/ether error is refused in preflight. The price and the v4
                               #   liquidity are DERIVED (script/LpSizing.sol) from LP_ETH_WEI and 100% of the QPULL supply.
                               #   THE BAND: seed() refuses to latch unless the add consumes the declared amounts within 50 bps.
LP_TOPUP_WEI=0                 # optional, wei of extra WETH on top of the mint's LP bucket (at most the larger of the bucket
                               #   and 1 ether, so a raise whose bucket is under 1 ether can top up to the 1 ether floor)
MAX_CONVERT_PER_CALL=          # REQUIRED, D18{QPULL}: pool-sized ceiling per Treasury.convert(). Never 0 or max.
MAX_WETH_CONVERT_PER_CALL=     # REQUIRED, wei: pool-sized WETH ceiling per convert(). Never 0 or max.
# ACCEPT_GENESIS_SLIP_SECS=    # optional, seconds: only when going live > 12h after GENESIS. Must be >= the actual slip.

# --- Phase 3b: the 10% prize seed (script/SeedRaffleVault.s.sol, run ONCE from SEED_TREASURY right after go-live, before the
#     opening draw at GENESIS + 48h) ---
#   forge script script/SeedRaffleVault.s.sol --rpc-url rh --account <seed treasury key>             (simulate)
#   forge script script/SeedRaffleVault.s.sol --rpc-url rh --account <seed treasury key> --broadcast
# Also required from above: NFT_ADDRESS, PRIZE_VAULT, QUOTRON, QUOTRON_ROUTER.
RAFFLE_ENGINE=                 # REQUIRED: the RaffleEngine from the Deploy export block. Must be the LIVE engine: the script walks
                               #   NFTCollection.taxHook() -> hook.packRegistry().engine() and refuses an orphan from an aborted
                               #   deploy. PRIZE_VAULT must equal RaffleEngine.vault().
VIEW_QUOTER=0xb8960fdC8A0Be155d196C2795b75747763562df2 # REQUIRED, Quotron View quoter (pinned on 4663; the seed floor quote)
SEED_ETH_WEI=                  # REQUIRED, wei of ETH to convert: the seed bucket SEED_TREASURY received from withdrawProceeds. The
                               #   script bounds it on-chain to 10% of what the mint raised: at a 3500-pass sell-out with the 25-pass
                               #   reserve, [2606250000000000000 - 3475, 2624250000000000000] wei.
# SEED_SLIPPAGE_BPS=100        # optional, bps below the VIEW_QUOTER quote for the floor (default 100, at most 1000)

# --- Phase 4: ownership handover (script/TransferOwnership.s.sol: TransferOwnership then VerifyOwnership) ---
# Also required from above: HOOK, KEEPER. The deployer is DERIVED on-chain (the lock's opener); there is no DEPLOYER input.
SAFE=                          # the Safe that takes ownership (2-of-3, proven with a real transaction first). On 4663 it must be a
                               #   canonical SafeL2 1.4.1 or SafeL2 1.5.0 proxy with NO enabled module (a non-L2 singleton, any
                               #   other version, or a module is refused).
SAFE_OWNERS_HASH=              # keccak256(abi.encode(SAFE, getOwners(), getThreshold())), read from the Safe's own UI
SAFE_SETUP_INITIALIZER=        # REQUIRED on 4663: the exact `initializer` bytes (0x...) of the factory call that created SAFE,
                               #   decoded from the creation transaction's input with the matching signature: createProxyWithNonce,
                               #   createChainSpecificProxyWithNonce, createProxyWithNonceL2 or createChainSpecificProxyWithNonceL2
                               #   (all (address,bytes,uint256); the L2 two exist on factory 1.5.0 only), or 1.4.1's
                               #   createProxyWithCallback(address,bytes,uint256,address). It is the second argument.
                               #   The gate recomputes SAFE's CREATE2 address from it and refuses a setup whose delegatecall target is
                               #   anything but nothing or Safe's canonical SafeToL2Setup (that delegatecall can plant hidden owners).
                               #   FAILS CLOSED, PERMANENTLY: the owners and threshold this setup declared must still be the Safe's.
                               #   ANY later owner or threshold change, a legitimate signer rotation included, makes TransferOwnership
                               #   refuse and VerifyOwnership fail for this Safe forever (no override). Keep the signers and threshold
                               #   fixed from creation, or rotate by moving ownership to a NEW Safe and re-proving with its values.
SAFE_SALT_NONCE=               # REQUIRED on 4663: the `saltNonce` argument (the third) of that same factory call (decimal).
                               #   For createProxyWithCallback it is the derived uint256(keccak256(abi.encodePacked(saltNonce, callback))).
LEADERBOARD_ENGINE=            # LeaderboardEngine — checked against ClaimManager's frozen engine->vault map
HOLDER_ENGINE=                 # HolderDrawEngine — checked against ClaimManager's frozen engine->vault map
