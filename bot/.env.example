# qpull-drawbot. READ-ONLY: it holds no wallet key and signs no transaction.
# Never put KEEPER_PK or CONVERT_PK in here. The bot does not need them and must never see them.

RPC_URL=https://rpc.rbc.robinhood.com

# The three prize engines it watches.
RAFFLE_ENGINE=
HOLDER_ENGINE=
LEADERBOARD_ENGINE=

# X (OAuth 1.0a user context: posting needs a USER token, an app-only bearer cannot post).
# From developer.x.com -> your app -> Keys and tokens. The access token pair must be
# regenerated AFTER the app is set to Read and write, or posting returns 403.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Safety. Leave DRY_RUN=true until the formatting looks right: it prints each post and sends nothing.
DRY_RUN=true
POLL_SECONDS=120
STATE_FILE=./state.json
# Optional: only announce draws at or after this block (default: from the first poll onward).
# START_BLOCK=

# X charges $0.200 per post CONTAINING A URL vs $0.015 without (13x). At ~38 posts/month that is
# $7.60 vs $0.57. Set false to drop the explorer link and stay in the cheap bucket.
INCLUDE_LINK=true

# A draw older than this is recorded but NOT posted, so a bot that was down does not wake up and
# fire several days of draws back to back. 18h covers a daily cadence with slack. 0 disables.
MAX_AGE_HOURS=18

# ClaimManager, for the daily claim digest (one summary per closed day). Unset disables it.
CLAIM_MANAGER=
