# QPULL testnet keeper config (MockDrandOracle short-clock). Copy to .env and fill in.
# All the addresses below come from the deploy output (Phase 3 DeployTestnet + Phase 1 DeployMint).

# --- network + keeper signer (a FRESH throwaway key you fund with a little testnet ETH; NOT the deployer) ---
RPC_URL=https://rpc.testnet.chain.robinhood.com
KEEPER_PK=0x_your_throwaway_keeper_private_key

# --- contracts (fill from deploy output) ---
ORACLE=0x            # MockDrandOracle (Phase 1 ORACLE_ADDR)
PACK_REGISTRY=0x     # Phase 3
NFT_COLLECTION=0x    # Phase 1 NFT_ADDR — keeper reads rarityOf/totalMinted to build the Super Rare index
RAFFLE_ENGINE=0x     # Phase 3
HOLDER_ENGINE=0x     # Phase 3 (HolderDrawEngine — weekly holder draw, funded by the 6.25% holder tax share)
LEADERBOARD_ENGINE=0x # Phase 3

# --- behavior ---
# keeper-testnet.js refuses Robinhood mainnet (chainId 4663): use keeper.js and .env.example there.
INTERVAL_SECONDS=15
# Reveal beacons (pack cohorts, NFT reveal) wait for their round's drand time on the CHAIN's clock, like real drand.
# manual = keeper posts beacons, and PRINTS a `cast send` for each ready draw for YOU to run.
# auto   = keeper sends the draws itself (hands-off runtime). You still buy/rip/claim in the UI either way.
DRAW_MODE=manual
DEPLOYER_ACCOUNT=deployer   # keystore name shown in the printed draw commands (your signer, not the keeper)
# SEND_WAIT_TIMEOUT_MS=120000  # a sent tx with no receipt after this long is logged at ERROR (hash, nonce) and abandoned

# --- convert (optional: funds the prize vaults from tax) ---
# Both are needed: TREASURY alone does nothing. ENABLE_CONVERT=true is the only value that sends Treasury.convert(),
# and the keeper key must hold the Treasury keeper role.
# TREASURY=0x
# ENABLE_CONVERT=false
