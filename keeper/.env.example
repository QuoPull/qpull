# --- QPULL keeper config (keeper.js). For the short-clock MockDrandOracle testnet keeper, start from
# --- .env.testnet.example instead. A key left blank (KEY=) is treated as UNSET, never as "" or 0.
RPC_URL=                     # your chain RPC (e.g. https://rpc.mainnet.chain.robinhood.com)
KEEPER_PK=                   # DRAW key. Hot by necessity (signs unattended every tick). Registered NOWHERE:
                             # every call it makes (submitBeacon, registerSuperRare, runDraw, distribute,
                             # runOpeningDraw, sweepExpired) is permissionless, so a stolen draw key gains an
                             # attacker nothing they could not already do from any address. Fund with a LITTLE gas.
CONVERT_PK=                  # CONVERT key (optional but recommended). The ONLY address to pass to
                             # Treasury.setKeeper, and the only key that signs convert(). Unset = convert signs
                             # with KEEPER_PK and the keeper warns at startup.
                             # A stolen convert key can sandwich a convert() via a chosen minOut, bounded by
                             # maxConvertPerCall/maxWethConvertPerCall and revocable via setKeeper.
                             # The keeper reads Treasury.isKeeper(<this address>) at startup and before every
                             # convert, and logs FATAL CONFIG with the setKeeper call if the role is missing.
                             # Both keys must be 64 hex digits (0x optional); a malformed key exits FATAL CONFIG
                             # naming the variable and its length, never its value.

# Contract addresses (fill from your deployment)
# PACK_REGISTRY is REQUIRED: the keeper's clock and every cohort reveal round come from it.
# Every address below that is set must be a valid address (a malformed one exits FATAL CONFIG, by name).
TREASURY=                    # Treasury. Convert reads its tokens, adapters and pool key through it.
RAFFLE_ENGINE=
LEADERBOARD_ENGINE=
HOLDER_ENGINE=               # HolderDrawEngine: weekly holder draw
PACK_REGISTRY=               # PackRegistry: clock, cohorts, registerSuperRare (SR daily auto-entry index)

# ── QuoPods (optional; leave blank until the pods ship, and every pods job no-ops) ──
POD_STAKING=                 # QuoPodStaking: pokeMany, which re-settles pods. PERMISSIONLESS, so failsafe runs it too
POD_MINT=                    # QuoPodMint: totalMinted, which bounds the sweep. Ids are 1..totalMinted and never burn
POD_POKE_INTERVAL_S=         # default 14400 (4h). This is the WINDOW a pod can earn at a stale-high weight, so it is
                             # a risk setting, not a performance one. Lower costs gas, higher widens the exposure
POD_POKE_BATCH=              # default 50 ids per pokeMany. One batch failing must not cost the rest of the sweep
POD_LOCK=                    # QuoPodLiquidityLock: collectFees pays the pool's 0.3% swap fee out (WETH to pods, QPOD burned). PERMISSIONLESS
POD_FEE_INTERVAL_S=          # default 21600 (6h). How often to collect; until someone does, the fees just wait in the pool
NFT_COLLECTION=              # NFTCollection: rarityOf/totalMinted to discover the Super Rare token ids
# CLAIM_MANAGER=             # optional: otherwise resolved from an engine's claimManager()
# MULTICALL3=0xcA11bde05977b3631167028862bE2a173976CA11   # optional: the claim sweeper's batch reader (canonical
                             # address by default; without code there it falls back to plain calls)

# Read from the chain, NOT configured here (keeper.js):
#   genesis, dayLength, revealDelay   <- PackRegistry
#   the drand oracle                  <- drand() on RAFFLE_ENGINE / PACK_REGISTRY / HOLDER_ENGINE / NFT_COLLECTION
#   QPULL, WETH, both swap adapters   <- Treasury.qpull() / weth() / qpullWeth() / wethQuotron()
#   the QPULL/WETH pool key           <- QpullWethAdapter.poolKey()
#   the sell-tax schedule, launchTime <- the pool key's hook
# For keeper.js, GENESIS, REVEAL_DELAY, DAY_LENGTH and ORACLE are only ASSERTIONS: the keeper exits FATAL CONFIG
# at startup when one disagrees with the chain. Leave them unset.
# EXCEPTION: keeper-testnet.js has no other source for the oracle and REQUIRES ORACLE. If one .env serves both
# programs, keep ORACLE set to the address the contracts read.

# Behavior
INTERVAL_SECONDS=60          # how often the loop ticks (everything is simulated first, so ticking often is cheap)
                             # Run `node keeper.js` under a supervisor. Do NOT schedule `--once` from cron: it
                             # keeps no backoff/idempotency state between runs, takes no lock, and it is NOT a
                             # dry run (it sends real beacon and draw transactions). It NEVER sends convert():
                             # with ENABLE_CONVERT=true it only reports floors + a simulation. README "Run".
                             # This file is read from the keeper/ directory, whatever the working directory
                             # (DOTENV_CONFIG_PATH in the process environment overrides the path).
# STARTUP_RETRY_S=600        # a startup read that fails (rate limit, 5xx) is retried this long before FATAL
# ALARM_REPEAT_S=900         # repeat cadence of the config/convert ERROR alarms; some alarms have their own
                             # (every tick, 10 min, hourly): README "Alarms" lists each one

# --- gas watch for BOTH hot signers (README "Keys") ---
# KEEPER_GAS_FLOOR_WEI=20000000000000000     # 0.02 ETH: LOW BALANCE alarm for the draw key below this
# CONVERT_GAS_FLOOR_WEI=5000000000000000     # 0.005 ETH: same for the convert key (watched with ENABLE_CONVERT=true or simulate)
# HEALTH_INTERVAL_S=300                      # balance + host-clock check cadence, and the "heartbeat:" line cadence
                                             # (alert when no heartbeat line appears: README "Monitoring")
# CLOCK_SKEW_WARN_S=60                       # warn when the host clock is this far BEHIND or AHEAD of the latest block
# SEND_WAIT_TIMEOUT_MS=120000                # a sent tx with no receipt after this long: ERROR with its hash and nonce,
                                             # nonce re-read, the next tick re-simulates (1000 to 3600000)

# --- convert (README "Convert") ---
# false (default) | simulate (quote, guard and simulate convert() every tick, send NOTHING) | true (the loop sends;
# --once never does). Go-live: arm the Treasury caps, authorize CONVERT_PK, set VIEW_QUOTER, run with simulate until
# the log shows "convert [simulate]: ... simulation SUCCEEDS; spot guard clear", then set true.
ENABLE_CONVERT=false
# Tax arrives as WETH (buys and sells), so the normal convert is a WETH-only sweep that needs only VIEW_QUOTER.
# VIEW_QUOTER is also the Quotron price check. FAIL CLOSED (the owner's choice): with the spot guard on and
# CONVERT_SPOT_UNAVAILABLE=hold (both defaults), leaving it unset HOLDS every convert with a repeated ERROR.
VIEW_QUOTER=0xb8960fdC8A0Be155d196C2795b75747763562df2   # Quotron View quoter (leg 2, WETH->QUOTRON), verified on RH mainnet
# QPULL_QUOTER=              # OPTIONAL v4 quoter for the QPULL/WETH pool (leg 1). Leg 1 only sells QPULL someone
                             # DONATED to the Treasury. Unset = that leg's floor comes from bisection, unguarded
                             # (info hourly). Configured = that leg is guarded: with the spot guard on and
                             # CONVERT_SPOT_UNAVAILABLE=hold (both defaults), a convert that needs leg 1 HOLDS
                             # whenever this quoter gives no reference quote (its quote fails, it is on a
                             # different PoolManager than the adapter, or the pool binding cannot be read or is
                             # wrong), and nothing is sent until that clears.
                             # script/DeployQuoter.s.sol deploys one after go-live.
CONVERT_SLIPPAGE_BPS=100     # 1% slippage floor applied to both convert() legs
# MIN_WETH_CONVERT_WEI=10000000000000000     # 0.01 WETH: a WETH-only sweep below this is skipped (not worth its gas).
                             # Keep it AT OR BELOW the Treasury's maxWethConvertPerCall (sized to the shallow
                             # QUOTRON pool, so possibly smaller than 0.01 WETH). If the cap is lower, the keeper
                             # uses the cap as the dust floor (full slices still convert) and logs an hourly ERROR.
# CONVERT_FAIL_ALARM=3                       # consecutive failed convert() attempts (or failed cap reads, or
                                             # held ticks on a failing reference quote) before the log escalates
# CONVERT_STALL_ALARM_H=6                    # ERROR when no convert has succeeded this long while tax is pending
# Spot guard: hold the convert while a fixed-size reference quote is this far below its recent median.
# CONVERT_PRICE_DEVIATION_BPS=500            # 0 disables the guard
# CONVERT_PRICE_WINDOW=15                    # ticks in the median
# CONVERT_PRICE_MIN_SAMPLES=5                # earlier ticks needed before the first convert after a restart
                                             # (and, when a convert moved the price past the limit, after it)
# CONVERT_PRICE_MAX_AGE_S=                   # unset = max(1800, 2 x INTERVAL_SECONDS x CONVERT_PRICE_MIN_SAMPLES);
                                             # set below that, the keeper exits FATAL CONFIG (it would never warm up)
# CONVERT_SPOT_UNAVAILABLE=hold              # hold (default, FAIL CLOSED) | proceed. hold: VIEW_QUOTER unset holds
                                             # every convert (ERROR at once); a configured VIEW_QUOTER or
                                             # QPULL_QUOTER whose reference quote fails holds (ERROR after
                                             # CONVERT_FAIL_ALARM ticks, also for an unreadable pool binding); a
                                             # QPULL_QUOTER on the wrong PoolManager, or a wrong pool binding,
                                             # holds with an ERROR at once. Only donated QPULL with no QPULL_QUOTER
                                             # configured runs unguarded (info hourly). proceed: convert on floors
                                             # from the pool state alone, without the guard.
# CONVERT_PRICE_REF_WETH_WEI=10000000000000000
# CONVERT_PRICE_REF_QPULL_WEI=1000000000000000000000
# Optional ASSERTIONS only (convert reads these from the chain):
#   a QPULL / WETH / WETH_QUOTRON_ADAPTER mismatch disables ALL converts with FATAL CONFIG;
#   a QPULL_POOL_* mismatch disables only the donated-QPULL leg (WETH-only sweeps continue). The hook was re-mined
#   when it moved to taking every tax in WETH, so a QPULL_POOL_HOOK copied from an older .env is wrong: leave these unset.
# QPULL=
# WETH=
# WETH_QUOTRON_ADAPTER=
# QPULL_POOL_FEE=
# QPULL_POOL_TICK_SPACING=
# QPULL_POOL_HOOK=

# --- drand beacons (README "Beacons") ---
# DRAND_RELAYS=https://api.drand.sh,https://api2.drand.sh,https://api3.drand.sh,https://drand.cloudflare.com
# DRAND_API=                 # legacy single relay; tried FIRST when set, before DRAND_RELAYS
# DRAND_TIMEOUT_MS=10000     # per request (100 to 300000); a hanging relay falls through to the next one
# DRAND_MARGIN_ROUNDS=3      # rounds past publication before a round is fetched
# DRAND_GRACE_ROUNDS=40      # a round every relay still answers 404 or 425 ("too early") for within this many
                             # rounds is pending, not an error

# --- other jobs ---
# ENABLE_SWEEP=true          # expired-claim sweep
# SWEEP_INTERVAL_S=3600
# SWEEP_MAX_PER_TICK=10
# VOID_BACKSCAN=14           # closed periods the void alarm examines
# NOOP_BACKOFF_BASE_S=60     # stand-down after a draw took a no-pay branch; doubles up to the max
# NOOP_BACKOFF_MAX_S=1800
